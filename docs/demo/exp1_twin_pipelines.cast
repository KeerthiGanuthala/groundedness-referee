[3.2, "o", "groundedness-referee :: Experiment 1 Walkthrough\r\n------------------------------------------------------------------------\r\n$ PYTHONPATH=src python3 -m groundedness_referee.cli twin-demo\r\n\r\n=== TWIN PIPELINE SYMMETRY BREAK (SEED = 20261117, N = 240 QA PAIRS) ===\r\nShared Headline Groundedness Score (2 d.p.): 0.59\r\n\r\n[1] pipeline_a_retriever_bottleneck (recall=0.60, faithful=0.95)\r\n    Groundedness Score : 0.5926 (128/216 answered)\r\n    Counterfactual Probe Blame:\r\n      - retrieval-miss                   :  90.9%\r\n      - generation-ignore                :   3.4%\r\n      - fabrication-with-evidence-present:   5.7%\r\n    Referee Verdict    : fix_retriever (+0.2269 gain vs +0.0231 wrong fix)\r\n"]
[5.0, "o", "groundedness-referee :: Experiment 1 Walkthrough\r\n------------------------------------------------------------------------\r\n$ PYTHONPATH=src python3 -m groundedness_referee.cli twin-demo\r\n\r\n=== TWIN PIPELINE SYMMETRY BREAK (SEED = 20261117, N = 240 QA PAIRS) ===\r\nShared Headline Groundedness Score (2 d.p.): 0.59\r\n\r\n[1] pipeline_a_retriever_bottleneck (recall=0.60, faithful=0.95)\r\n    Groundedness Score : 0.5926 (128/216 answered)\r\n    Referee Blame      : retrieval-miss=90.9%, gen-ignore=3.4%, gen-fab=5.7%\r\n    Referee Verdict    : fix_retriever  --> +0.2269 gain (vs +0.0231 wrong fix)\r\n\r\n[2] pipeline_b_generator_bottleneck (recall=0.95, faithful=0.635)\r\n    Groundedness Score : 0.5929 (134/226 answered)\r\n    Referee Blame      : retrieval-miss=7.6%, gen-ignore=41.3%, gen-fab=40.2%\r\n    Referee Verdict    : fix_generator  --> +0.2336 gain (vs +0.0265 wrong fix)\r\n\r\nConclusion: Same 0.59 score, opposite root causes, opposite sprint fixes.\r\n"]
